    {
      "name": "LoginAdmin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test(\"La respuesta contiene un token\", function () {",
              "    pm.expect(response.token).to.exist;",
              "    pm.expect(response.token).to.be.a(\"string\");",
              "});",
              "",
              "pm.test(\"El usuario es admin\", function () {",
              "    pm.expect(response.user.username).to.eql(\"admin\");",
              "});",
              "",
              "pm.test(\"El rol es admin\", function () {",
              "    pm.expect(response.user.role).to.eql(\"admin\");",
              "});",
              "",
              "pm.test(\"El admin puede gestionar productos\", function () {",
              "    pm.expect(response.user.permissions.manageProducts).to.eql(true);",
              "});",
              "",
              "pm.test(\"El admin puede eliminar productos\", function () {",
              "    pm.expect(response.user.permissions.deleteProducts).to.eql(true);",
              "});",
              "",
              "pm.test(\"El admin puede ver todas las órdenes\", function () {",
              "    pm.expect(response.user.permissions.viewAllOrders).to.eql(true);",
              "});",
              "",
              "pm.environment.set(\"adminToken\", response.token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
