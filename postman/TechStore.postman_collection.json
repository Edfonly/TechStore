    {
      "name": "RegistrarProducto",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "",
              "const expectedStatus = Number(pm.variables.get(\"expectedStatus\"));",
              "const expectedError = pm.variables.get(\"expectedError\");",
              "",
              "pm.test(\"Status code correcto\", function () {",
              "    pm.response.to.have.status(expectedStatus);",
              "});",
              "",
              "pm.test(\"La respuesta contiene JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "if (expectedStatus === 201) {",
              "",
              "    const requestBody = JSON.parse(pm.variables.get(\"requestBody\"));",
              "",
              "    pm.test(\"El producto fue creado con ID\", function () {",
              "        pm.expect(response.id).to.exist;",
              "        pm.expect(response.id).to.be.a(\"number\");",
              "        pm.expect(response.id).to.be.above(0);",
              "    });",
              "",
              "    pm.test(\"Los datos del producto son correctos\", function () {",
              "        pm.expect(response.name).to.eql(requestBody.name);",
              "        pm.expect(response.description).to.eql(requestBody.description);",
              "        pm.expect(response.price).to.eql(requestBody.price);",
              "        pm.expect(response.category).to.eql(requestBody.category);",
              "        pm.expect(response.stock).to.eql(requestBody.stock);",
              "    });",
              "",
              "    pm.environment.set(\"productId\", response.id);",
              "",
              "} else {",
              "",
              "    pm.test(\"El mensaje de error es correcto\", function () {",
              "        pm.expect(response.error).to.eql(expectedError);",
              "    });",
              "",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
